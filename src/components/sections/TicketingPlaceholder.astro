---
/**
 * Encart billetterie du prototype.
 * Texte imposé en français : « compte Weezevent SETF, accès à venir ».
 * Pas d'iframe, pas d'appel réseau.
 */
import { useTranslations, type Lang } from '@/lib/i18n';

interface Props { id?: string; class?: string; lang?: Lang }
const { id = 'billetterie', class: className = '', lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---

<section id={id} class:list={['scroll-mt-28 rounded-md border-2 border-dashed border-dore bg-creme p-6 md:p-8', className]} data-billetterie aria-labelledby={`${id}-titre`}>
  <p class="eyebrow">{t('tickets.eyebrow')}</p>
  <h2 id={`${id}-titre`} class="mt-2 text-3xl">{t('tickets.title')}</h2>
  <p class="mt-3 max-w-2xl text-ardoise">{t('tickets.text')}</p>
</section>
