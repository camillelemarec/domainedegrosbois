---
/**
 * Footer bleu nuit (maquette p.10 ; benchmark enseignement 9) : logo rappelé, liens
 * institutionnels, adresse/téléphone, réseaux, bandeau des 6 labels, partenaires, logo SETF,
 * liens croisés LeTROT, bouton « Gérer mes cookies ».
 */
import navigation from '@/data/navigation.json';
import site from '@/data/site.json';
import { localizePath, useTranslations, type Lang } from '@/lib/i18n';
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import SocialIcons from '@/components/nav/SocialIcons.astro';
import LabelsBar from '@/components/sections/LabelsBar.astro';
import PartnersStrip from '@/components/sections/PartnersStrip.astro';
import { resolveImage } from '@/lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const l = (p: string) => localizePath(p, lang);
const year = new Date().getFullYear();
const setf = resolveImage('logo.setf', lang);
---

<footer class="mt-auto bg-nuit text-bleu-clair">
  <LabelsBar lang={lang} />

  <div class="container-site grid gap-10 py-12 md:grid-cols-2 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <a href={l('/')} class="inline-flex h-14 items-center"><Logo lang={lang} variant="light" /></a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed">{site.shortDescription[lang] ?? site.shortDescription.fr}</p>
      <SocialIcons lang={lang} class="mt-4 -ml-3" />
    </div>

    <div class="lg:col-span-3">
      <h2 class="font-body text-sm font-semibold uppercase tracking-[0.15em] text-dore">{t('footer.address')}</h2>
      <address class="mt-3 text-sm not-italic leading-relaxed">
        <span class="block font-semibold text-white">{site.name}</span>
        <span class="block">{site.address.street}</span>
        <span class="block">{site.address.postalCode} {site.address.city}</span>
        <a href={site.phone.href} class="mt-2 inline-flex items-center gap-2 text-white hover:underline underline-offset-4"><Icon name="phone" size={16} />{site.phone.display}</a>
        <br />
        <a href={site.email.href} class="inline-flex items-center gap-2 text-white hover:underline underline-offset-4"><Icon name="mail" size={16} />{site.email.display}</a>
      </address>
      <p class="mt-3 text-xs opacity-80">{site.hours[lang] ?? site.hours.fr}</p>
    </div>

    <nav class="lg:col-span-3" aria-label={t('a11y.footerNav')}>
      <h2 class="font-body text-sm font-semibold uppercase tracking-[0.15em] text-dore">{t('meta.siteName')}</h2>
      <ul class="mt-3 space-y-1 text-sm">
        {navigation.footer.map((item) => (
          <li>
            {item.href ? (
              <a href={l(item.href)} class="inline-block min-h-9 py-1.5 text-white hover:underline underline-offset-4">{t(item.label)}</a>
            ) : (
              <span class="inline-block min-h-9 py-1.5 text-white/65">{t(item.label)} — hors de ce prototype</span>
            )}
          </li>
        ))}
        <li>
          <button type="button" class="inline-flex min-h-9 items-center gap-2 py-1.5 text-white hover:underline underline-offset-4" data-cookie-settings>
            <Icon name="cookie" size={16} />{t('footer.cookieSettings')}
          </button>
        </li>
      </ul>
    </nav>

    <div class="lg:col-span-2">
      <h2 class="font-body text-sm font-semibold uppercase tracking-[0.15em] text-dore">LeTROT</h2>
      <ul class="mt-3 space-y-1 text-sm">
        {site.crossLinks.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener" class="inline-flex min-h-9 items-center gap-1.5 py-1.5 text-white hover:underline underline-offset-4">
              {link.label}<Icon name="external" size={13} label={t('a11y.externalLink')} />
            </a>
          </li>
        ))}
        <li><a href={site.legalLinks.letrotPrivacy} target="_blank" rel="noopener" class="inline-flex min-h-9 items-center gap-1.5 py-1.5 text-white hover:underline underline-offset-4">{t('footer.privacy')} (LeTROT)<Icon name="external" size={13} label={t('a11y.externalLink')} /></a></li>
      </ul>
    </div>
  </div>

  <PartnersStrip lang={lang} />

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col items-center justify-between gap-4 py-6 text-xs md:flex-row">
      <p>{t('footer.copyright', { year })}</p>
      <a href={site.publisher.website} target="_blank" rel="noopener" class="inline-flex items-center gap-3 text-white hover:underline underline-offset-4">
        <span class="h-9 w-auto">
          {setf.exists ? <img src={setf.url} alt="" class="h-9 w-auto" /> : <span class="grid h-9 min-w-9 place-items-center rounded-sm border border-white/30 px-2 font-display text-sm font-semibold tracking-wider text-white">SETF</span>}
        </span>
        <span>{t('footer.setf')}</span>
        <Icon name="external" size={13} label={t('a11y.externalLink')} />
      </a>
    </div>
  </div>
</footer>
