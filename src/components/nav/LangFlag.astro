---
/**
 * Bascule FR / EN : un seul drapeau, celui de la langue vers laquelle on passe.
 */
import { alternatePath, useTranslations, type Lang } from '@/lib/i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);
const target: Lang = lang === 'fr' ? 'en' : 'fr';
const title = target === 'en' ? 'English' : 'Français';
---

<a
  href={alternatePath(Astro.url, target)}
  hreflang={target}
  lang={target}
  aria-label={t('a11y.switchLang')}
  title={title}
  class:list={['lang-toggle grid h-11 w-11 shrink-0 place-items-center rounded-sm hover:bg-white/15', className]}
>
  {target === 'en' ? (
    <svg viewBox="0 0 60 30" class="h-3.5 w-5 rounded-[1px] shadow-[0_0_0_1px_rgba(0,0,0,0.2)]" aria-hidden="true">
      <defs>
        <clipPath id="flag-gb"><rect width="60" height="30" /></clipPath>
      </defs>
      <g clip-path="url(#flag-gb)">
        <rect width="60" height="30" fill="#012169" />
        <path d="M0 0 60 30M60 0 0 30" stroke="#fff" stroke-width="8" />
        <path d="M0 0 60 30M60 0 0 30" stroke="#C8102E" stroke-width="4" />
        <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="14" />
        <path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="8" />
      </g>
    </svg>
  ) : (
    <svg viewBox="0 0 60 40" class="h-3.5 w-5 rounded-[1px] shadow-[0_0_0_1px_rgba(0,0,0,0.2)]" aria-hidden="true">
      <rect width="20" height="40" fill="#002395" />
      <rect x="20" width="20" height="40" fill="#fff" />
      <rect x="40" width="20" height="40" fill="#ED2939" />
    </svg>
  )}
</a>
