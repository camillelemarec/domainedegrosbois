---
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import site from '@/data/site.json';
import { useTranslations, type Lang } from '@/lib/i18n';

interface Props { lang?: Lang; class?: string; size?: number }
const { lang = 'fr', class: className = '', size = 18 } = Astro.props;
const t = useTranslations(lang);
---

<ul class:list={['flex items-center gap-1', className]} aria-label={t('a11y.social')}>
  {site.social.map((s) => (
    <li>
      <a
        href={s.url}
        class="grid h-11 w-11 place-items-center rounded-full transition hover:bg-white/15"
        aria-label={`${s.label} ${t('a11y.externalLink')}`}
        rel="noopener"
        target={s.url.startsWith('http') ? '_blank' : undefined}
      >
        <Icon name={s.id as IconName} size={size} />
      </a>
    </li>
  ))}
</ul>
