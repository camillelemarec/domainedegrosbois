---
/**
 * Logo du Domaine : utilise `logo/logo-grosbois-2023.svg` si présent, sinon un logotype
 * typographique provisoire (DOMAINE en linéale / GROSBOIS en garalde, cf. charte 2015 p.6).
 */
import { resolveImage } from '@/lib/images';
import type { Lang } from '@/lib/i18n';

interface Props {
  lang?: Lang;
  variant?: 'color' | 'light';
  size?: 'md' | 'lg';
  class?: string;
}
const { lang = 'fr', variant = 'color', size = 'md', class: className = '' } = Astro.props;
const logo = resolveImage('logo.grosbois', lang);
const light = variant === 'light';
---

{logo.exists ? (
  <img src={logo.url} alt={logo.altText} class:list={['h-full w-auto', className]} width="180" height="56" />
) : (
  <span class:list={['logo-wordmark inline-flex items-center gap-2.5', size === 'lg' && 'logo-lg', className]} role="img" aria-label={logo.altText}>
    <img src="/images/logo/logogb.png" alt="" class="logo-mark" width={size === 'lg' ? 72 : 40} height={size === 'lg' ? 72 : 40} />
    <span class="flex flex-col leading-none">
      <span class:list={['font-display text-[0.78rem] font-semibold tracking-[0.28em] uppercase', light ? 'text-bleu-clair' : 'text-ardoise']}>Domaine de</span>
      <span class:list={['font-display text-[1.55rem] font-semibold tracking-wide uppercase -mt-0.5', light ? 'text-white' : 'text-bleu']}>Grosbois</span>
    </span>
  </span>
)}

<style>
  .logo-mark { width: 2.75rem; height: 2.75rem; flex: none; object-fit: contain; }
  .logo-lg .logo-mark { width: 4.75rem; height: 4.75rem; }
  .logo-lg { gap: 0.85rem; }
</style>
