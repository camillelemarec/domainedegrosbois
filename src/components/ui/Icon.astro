---
/**
 * Jeu de pictogrammes inline (traits 24×24, style Lucide). Décoratifs par défaut (`aria-hidden`),
 * passer `label` pour un picto porteur de sens.
 */
import { iconPaths, type IconName } from '@/components/ui/icons';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = '', label, strokeWidth = 1.75 } = Astro.props;

---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={iconPaths[name]}
/>
