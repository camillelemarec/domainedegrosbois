---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
---

<BaseLayout title="Grosbois & vous" description="Engagements, soutien, recrutement et équipes du Domaine de Grosbois. Page à venir.">
  <div class="container-site py-10">
    <Breadcrumb lang="fr" items={[{ label: 'Grosbois & vous' }]} />
