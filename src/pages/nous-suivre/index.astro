---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
import Img from '@/components/media/Img.astro';
import { formatDate, pick, useTranslations, type Lang } from '@/lib/i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const actualites = (await getCollection('actualites')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout lang={lang} title={t('pages.followTitle')} description={t('pages.followDescription')}>
  <Hero
    image="accueil.hero"
    lang={lang}
    variant="short"
    eyebrow={t('pages.followTitle')}
    title={t('pages.followTitle')}
    subtitle={t('pages.followLead')}
  />

  <div class="container-site py-6">
    <Breadcrumb lang={lang} items={[{ label: t('pages.followTitle') }]} />
  </div>

  <section class="section !pt-0" aria-labelledby="actualites-page">
    <div class="container-site">
      <h2 id="actualites-page" class="font-display text-3xl">{t('pages.news')}</h2>
      <ul class="mt-8 grid gap-8 md:grid-cols-3">
        {actualites.map((article) => (
          <li class="overflow-hidden rounded-md border border-bleu-clair bg-white">
            <Img image={article.data.image} lang={lang} ratio="4/3" />
            <div class="p-5">
              <time datetime={article.data.date} class="text-xs font-semibold uppercase tracking-wider text-dore-fonce">{formatDate(article.data.date, lang, { weekday: undefined })}</time>
              <h3 class="mt-2 font-display text-2xl">{pick(article.data.titre, lang)}</h3>
              <p class="mt-2 text-ardoise">{pick(article.data.extrait, lang)}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
