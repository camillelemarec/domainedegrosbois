---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
import EventCard from '@/components/cards/EventCard.astro';
import TicketingPlaceholder from '@/components/sections/TicketingPlaceholder.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { eventAudienceLabel, eventTypeLabel, EVENT_AUDIENCES, EVENT_TYPES, monthKey, monthLabel } from '@/lib/events';
import { localizePath, pick, useTranslations, type Lang } from '@/lib/i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const evenements = (await getCollection('evenements')).sort((a, b) => a.data.dateDebut.localeCompare(b.data.dateDebut));
const months = [...new Set(evenements.map((event) => monthKey(event.data.dateDebut)))];

const weekdays = lang === 'fr'
  ? ['lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.', 'dim.']
  : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

function monthCells(key: string) {
  const [year, month] = key.split('-').map(Number);
  const first = new Date(year, month - 1, 1);
  const pad = (first.getDay() + 6) % 7;
  const count = new Date(year, month, 0).getDate();
  const inMonth = evenements.filter((event) => monthKey(event.data.dateDebut) === key);
  const byDay = new Map<number, { id: string; titre: string }[]>();
  for (const event of inMonth) {
    const day = Number(event.data.dateDebut.slice(8, 10));
    const list = byDay.get(day) ?? [];
    list.push({ id: event.id, titre: pick(event.data.titre, lang) });
    byDay.set(day, list);
  }
  const cells: ({ day: number; events: { id: string; titre: string }[] } | null)[] = [
    ...Array.from({ length: pad }, () => null),
    ...Array.from({ length: count }, (_, index) => ({ day: index + 1, events: byDay.get(index + 1) ?? [] })),
  ];
  while (cells.length % 7 !== 0) cells.push(null);
  return cells;
}
---

<BaseLayout lang={lang} title={t('agenda.title')} description={t('agenda.pageDescription')}>
  <Hero
    image="accueil.hero"
    lang={lang}
    variant="short"
    eyebrow={t('nav.suivre')}
    title={t('agenda.title')}
    subtitle={t('agenda.pageLead')}
  />

  <div class="container-site py-6">
    <Breadcrumb lang={lang} items={[{ label: t('agenda.title') }]} />
  </div>

  <section class="section !pt-0" aria-labelledby="filtres-titre">
    <div class="container-site">
      <h2 id="filtres-titre" class="sr-only">{t('agenda.filterTitle')}</h2>
      <form class="grid gap-4 rounded-md border border-bleu-clair bg-gris-clair p-4 md:grid-cols-3" data-filters>
        <label class="field">
          <span class="field-label">{t('agenda.filterType')}</span>
          <select class="select" data-filter="type">
            <option value="tous">{t('agenda.all')}</option>
            {EVENT_TYPES.map((type) => <option value={type}>{eventTypeLabel(type, lang)}</option>)}
          </select>
        </label>
        <label class="field">
          <span class="field-label">{t('agenda.filterAudience')}</span>
          <select class="select" data-filter="audience">
            <option value="tous">{t('agenda.all')}</option>
            {EVENT_AUDIENCES.map((audience) => <option value={audience}>{eventAudienceLabel(audience, lang)}</option>)}
          </select>
        </label>
        <label class="field">
          <span class="field-label">{t('agenda.filterMonth')}</span>
          <select class="select" data-filter="month">
            <option value="tous">{t('agenda.all')}</option>
            {months.map((month) => <option value={month}>{monthLabel(month, lang)}</option>)}
          </select>
        </label>
      </form>
      <p class="mt-4 text-sm font-semibold text-nuit" data-event-count data-count-template={t('agenda.results')}>{t('agenda.results', { count: evenements.length })}</p>

      <div class="mt-8 grid gap-6 lg:grid-cols-2" data-calendars>
        {months.map((month) => (
          <article class="rounded-md border border-bleu-clair p-4" data-month-panel={month}>
            <h3 class="text-xl capitalize">{monthLabel(month, lang)}</h3>
            <div class="mt-3 grid grid-cols-7 gap-1 text-center text-xs font-semibold uppercase tracking-wider text-ardoise">
              {weekdays.map((day) => <div class="py-1">{day}</div>)}
            </div>
            <div class="mt-1 grid grid-cols-7 gap-1">
              {monthCells(month).map((cell) => (
                <div class:list={['min-h-16 rounded-sm p-1 text-sm', cell ? 'bg-gris-clair' : 'bg-transparent']}>
                  {cell && (
                    <>
                      <span class:list={['font-semibold', cell.events.length ? 'text-bleu' : 'text-ardoise']}>{cell.day}</span>
                      <ul>
                        {cell.events.map((event) => (
                          <li>
                            <a href={`#evenement-${event.id}`} class="mt-0.5 block truncate text-xs font-medium text-brique-fonce underline-offset-2 hover:underline">{event.titre}</a>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3" data-event-list>
        {evenements.map((event) => <EventCard event={event} lang={lang} headingLevel="h2" />)}
      </div>
      <p class="mt-6 rounded-md border border-dashed border-ardoise-clair p-4 text-ardoise" data-event-empty hidden>{t('agenda.noResult')}</p>
    </div>
  </section>

  <section class="section !pt-0">
    <div class="container-site">
      <TicketingPlaceholder lang={lang} />
    </div>
  </section>

  <CtaBanner
    title={t('agenda.groupsTitle')}
    text={t('agenda.groupsBanner')}
    actions={[{ label: t('agenda.groupsCta'), href: localizePath('/visiter/reserver/', lang), style: 'gold' }]}
  />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-event]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-month-panel]'));
  const count = document.querySelector<HTMLElement>('[data-event-count]');
  const empty = document.querySelector<HTMLElement>('[data-event-empty]');
  if (!form) throw new Error('filtres agenda absents');

  const read = (name: string) => form.querySelector<HTMLSelectElement>(`[data-filter="${name}"]`)?.value ?? 'tous';

  function apply() {
    const type = read('type');
    const audience = read('audience');
    const month = read('month');
    let visible = 0;
    for (const card of cards) {
      const ok =
        (type === 'tous' || card.dataset.type === type) &&
        (audience === 'tous' || card.dataset.audience === audience) &&
        (month === 'tous' || card.dataset.month === month);
      card.hidden = !ok;
      if (ok) visible += 1;
    }
    for (const panel of panels) panel.hidden = month !== 'tous' && panel.dataset.monthPanel !== month;
    if (count) count.textContent = (count.dataset.countTemplate ?? '{count}').replace('{count}', String(visible));
    if (empty) empty.hidden = visible !== 0;
  }

  form.addEventListener('change', apply);
</script>
