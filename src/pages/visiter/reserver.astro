---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteForm from '@/components/forms/QuoteForm.astro';
import { pick, useTranslations, type Lang } from '@/lib/i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const espaces = (await getCollection('espaces'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((espace) => ({ id: espace.id, nom: pick(espace.data.nom, lang) }));
---

<BaseLayout lang={lang} title={t('quote.titleVisit')} description={t('quote.metaVisit')}>
  <QuoteForm
    lang={lang}
    contexte="visite"
    espaces={espaces}
    intro={t('quote.introVisit')}
  />
</BaseLayout>
