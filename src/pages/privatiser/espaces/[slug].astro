---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
import AnchorSideNav from '@/components/nav/AnchorSideNav.astro';
import CapacityGrid from '@/components/sections/CapacityGrid.astro';
import Gallery from '@/components/media/Gallery.astro';
import Img from '@/components/media/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/lib/i18n';

export async function getStaticPaths() {
  const espaces = await getCollection('espaces');
  return espaces.map((espace) => ({ params: { slug: espace.id }, props: { espace } }));
}

interface Props { espace: CollectionEntry<'espaces'> }
const { espace } = Astro.props;
const lang = 'fr' as const;
const t = useTranslations(lang);
const data = espace.data;
const nom = data.nom.fr;
const autres = (await getCollection('espaces'))
  .filter((item) => item.id !== espace.id)
  .sort((a, b) => a.data.ordre - b.data.ordre);
const devisHref = `/privatiser/demande-de-devis/?espace=${espace.id}`;

const anchors = [
  { id: 'scenographie', label: t('space.scenography') },
  { id: 'capacites', label: t('space.capacities') },
  ...(data.histoire.length ? [{ id: 'histoire', label: t('space.history') }] : []),
  { id: 'technique', label: t('space.technical') },
  { id: 'prestations', label: t('space.services') },
  { id: 'acces', label: t('space.access') },
  ...(data.images.galerie.length ? [{ id: 'galerie', label: t('space.gallery') }] : []),
  { id: 'devis', label: t('space.quote') },
];
---

<BaseLayout title={nom} description={data.accroche.fr} mainClass="pb-24 lg:pb-0">
  <div class="container-site py-4">
    <Breadcrumb lang={lang} items={[{ label: 'Privatiser', href: '/#privatiser' }, { label: nom }]} />
  </div>

  <Hero image={data.images.hero} lang={lang} variant="short" eyebrow="Privatiser" title={nom} subtitle={data.accroche.fr}>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      {data.provisoire && <span class="badge badge-provisional">Fiche provisoire</span>}
      {data.surface && <span class="badge badge-gold">{data.surface}</span>}
      <a href={devisHref} class="btn btn-cta">{t('common.quote')}<Icon name="arrow-right" size={18} /></a>
    </div>
  </Hero>

  <div class="container-site grid gap-10 py-10 lg:grid-cols-[16rem_minmax(0,1fr)] lg:items-start">
    <AnchorSideNav lang={lang} items={anchors} cta={{ label: t('common.quote'), href: devisHref }} />

    <div class="min-w-0 space-y-14">
      <section id="scenographie" class="scroll-mt-32">
        <h2>{t('space.scenography')}</h2>
        <div class="prose-site mt-4">
          {data.description.map((paragraph) => <p>{paragraph.fr}</p>)}
        </div>
      </section>

      <section id="capacites" class="scroll-mt-32">
        <h2>{t('space.capacities')}</h2>
        <div class="mt-4">
          <CapacityGrid capacites={data.capacites} lang={lang} provisoire={data.provisoire} />
        </div>
      </section>

      {data.histoire.length > 0 && (
        <section id="histoire" class="scroll-mt-32">
          <h2>{t('space.history')}</h2>
          <div class="prose-site mt-4">
            {data.histoire.map((paragraph) => <p>{paragraph.fr}</p>)}
          </div>
        </section>
      )}

      <section id="technique" class="scroll-mt-32">
        <h2>{t('space.technical')}</h2>
        <dl class="mt-4 divide-y divide-bleu-clair border-y border-bleu-clair">
          {data.ficheTechnique.map((row) => (
            <div class="grid gap-1 py-3 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-6">
              <dt class="text-sm font-semibold text-nuit">{row.label.fr}</dt>
              <dd class="text-sm text-ardoise">{row.valeur.fr}</dd>
            </div>
          ))}
          {data.exploitant && (
            <div class="grid gap-1 py-3 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-6">
              <dt class="text-sm font-semibold text-nuit">{t('space.operator')}</dt>
              <dd class="text-sm text-ardoise">{data.exploitant.nom}</dd>
            </div>
          )}
        </dl>
      </section>

      <section id="prestations" class="scroll-mt-32">
        <h2>{t('space.services')}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {data.prestations.map((item) => (
            <li class="flex items-start gap-3 rounded-md border border-bleu-clair bg-white p-4 text-sm font-medium text-nuit">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-dore-fonce" />{item.fr}
            </li>
          ))}
        </ul>
      </section>

      <section id="acces" class="scroll-mt-32">
        <h2>{t('space.access')}</h2>
        <p class="prose-site mt-4">{data.acces?.fr}</p>
        <div class="mt-4 max-w-xl">
          <Img image="acces.plan" lang={lang} ratio="4/3" class="rounded-md" />
        </div>
      </section>

      {data.images.galerie.length > 0 && (
        <section id="galerie" class="scroll-mt-32">
          <h2>{t('space.gallery')}</h2>
          <Gallery class="mt-4" images={data.images.galerie} lang={lang} />
        </section>
      )}

      {data.temoignages.length > 0 && (
        <section aria-labelledby="temoignages" class="scroll-mt-32">
          <h2 id="temoignages">{t('space.testimonials')}</h2>
          <ul class="mt-4 grid gap-4 md:grid-cols-2">
            {data.temoignages.map((item) => (
              <li class="rounded-md bg-creme p-5">
                <blockquote class="font-display text-xl text-nuit">« {item.citation.fr} »</blockquote>
                <p class="mt-3 text-sm font-semibold text-ardoise">{item.auteur}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section id="devis" class="scroll-mt-32 rounded-md bg-bleu p-6 text-white md:p-8">
        <h2 class="!text-white">{t('space.ctaTitle')}</h2>
        <p class="mt-2 max-w-2xl text-white/85">{t('space.ctaText')}</p>
        <a href={devisHref} class="btn btn-gold mt-6">{t('common.quote')}<Icon name="arrow-right" size={18} /></a>
      </section>

      {autres.length > 0 && (
        <section aria-labelledby="autres-espaces">
          <h2 id="autres-espaces">{t('space.otherSpaces')}</h2>
          <ul class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-3">
            {autres.map((item) => (
              <li>
                <a href={`/privatiser/espaces/${item.id}/`} class="group relative block overflow-hidden rounded-md">
                  <Img image={item.data.images.vignette} lang={lang} ratio="4/3" class="transition-transform duration-500 group-hover:scale-105" />
                  <div class="overlay-card absolute inset-0" aria-hidden="true"></div>
                  <span class="absolute inset-x-0 bottom-0 p-3 font-display text-lg text-white">{item.data.nom.fr}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>

  <div class="fixed inset-x-0 bottom-0 z-30 border-t border-bleu-clair bg-white p-3 shadow-md lg:hidden">
    <a href={devisHref} class="btn btn-cta w-full">{t('common.quote')}</a>
  </div>
</BaseLayout>
