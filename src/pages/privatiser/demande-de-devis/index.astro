---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteForm from '@/components/forms/QuoteForm.astro';

const espaces = (await getCollection('espaces'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((espace) => ({ id: espace.id, nom: espace.data.nom.fr }));
---

<BaseLayout title="Demander un devis" description="Formulaire de devis pour une privatisation ou une visite au Domaine de Grosbois. Simulation à l'écran, sans envoi.">
  <QuoteForm
    contexte="privatisation"
    espaces={espaces}
    intro="Décrivez un projet de privatisation ou de visite. Le récapitulatif s'affiche ici, avec un devis indicatif si vous choisissez « réservation »."
  />
</BaseLayout>
