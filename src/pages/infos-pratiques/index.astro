---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
import { useTranslations, type Lang } from '@/lib/i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('pages.infoTitle')} description={t('pages.infoDescription')}>
  <div class="container-site py-10">
    <Breadcrumb lang={lang} items={[{ label: t('pages.infoTitle') }]} />
    <h1 class="mt-8">{t('pages.infoTitle')}</h1>
    <p class="lede mt-4 max-w-2xl text-ardoise">{t('pages.infoLead')}</p>
  </div>
</BaseLayout>
